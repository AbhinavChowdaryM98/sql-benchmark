# Dataset to benchmark (bird, spider)
DATASET=bird

# Agent configuration
AGENT_URL=http://localhost:4747/sql-query
AGENT_API_KEY=
AGENT_PROVIDER=XAI

# Benchmark settings
WORKERS=4
USE_HINTS=true
USE_QDRANT_HINTS=false
MAX_QUESTIONS=-1
REQUEST_TIMEOUT=60

# Filtering
DIFFICULTIES=
DBS=

# Data and output directories
BIRD_DATA_DIR=./bird_data
OUTPUT=./results/benchmark